# ─────────────────────────────────────────────────
# Duomenų bazė (MySQL – freehosting.lt)
# Kredencialus rasite hostingo panelėje → Databases
# ─────────────────────────────────────────────────
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME"

# ─────────────────────────────────────────────────
# NextAuth.js
# ─────────────────────────────────────────────────
NEXTAUTH_URL="https://padeliotrenere.lt"
# Generuokite: openssl rand -hex 32
NEXTAUTH_SECRET="keiskite-i-tikra-slaptazodi-32-simboliu"

# ─────────────────────────────────────────────────
# Google OAuth (neprivaloma – magic link veikia be jo)
# https://console.cloud.google.com → Credentials → OAuth 2.0
# ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─────────────────────────────────────────────────
# El. paštas – Resend (https://resend.com)
# SMTP naudojamas NextAuth magic link siuntimui
# ─────────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="Padelio Treneris <noreply@padeliotrenere.lt>"

# NextAuth EmailProvider naudoja SMTP
# Resend SMTP: smtp.resend.com:465, user=resend, pass=API_KEY
EMAIL_SERVER_HOST="smtp.resend.com"
EMAIL_SERVER_PORT="465"
EMAIL_SERVER_USER="resend"
EMAIL_SERVER_PASSWORD="re_xxxxxxxxxxxxxxxxxxxx"

# Trenerio el. paštas – gaus žinutes iš kontaktų formos
TRAINER_EMAIL="vardas@padeliotrenere.lt"

# ─────────────────────────────────────────────────
# Web Push (VAPID)
# Generuokite: npx web-push generate-vapid-keys
# ─────────────────────────────────────────────────
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# SUBJECT – kontaktinis el. paštas arba URL
VAPID_SUBJECT="mailto:info@padeliotrenere.lt"
# Naudojamas kliento pusėje (subscribe)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# ─────────────────────────────────────────────────
# Programos URL
# ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://padeliotrenere.lt"

# ─────────────────────────────────────────────────
# Admin paskyra
# Pirmą kartą prisijungus su šiuo el. paštu
# paskyra automatiškai gaus ADMIN rolę
# ─────────────────────────────────────────────────
ADMIN_EMAIL="admin@padeliotrenere.lt"
