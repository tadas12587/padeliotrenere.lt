// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  CLIENT
  TRAINER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum TrainerStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ArenaStatus {
  PENDING
  APPROVED
}

enum SlotStatus {
  AVAILABLE
  BOOKED
}

enum ServiceType {
  INDIVIDUAL
  GROUP
}

enum PriceType {
  TOTAL
  PER_PERSON
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  password      String?   @db.VarChar(255)
  role          Role      @default(CLIENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  bookings          Booking[]
  pushSubscriptions PushSubscription[]
  trainerProfile    TrainerProfile?
  createdArenas     Arena[]
  reviews           Review[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model TimeSlot {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  startTime   String   // "09:00"
  endTime     String   // "10:00"
  isAvailable Boolean  @default(true)
  maxClients  Int      @default(1)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings Booking[]

  @@unique([date, startTime])
}

model Booking {
  id          String        @id @default(cuid())
  userId      String
  slotId      String?
  status      BookingStatus @default(PENDING)
  clientNotes String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  trainerId          String?
  arenaId            String?
  serviceId          String?
  availabilitySlotId String?

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  slot             TimeSlot?         @relation(fields: [slotId], references: [id])
  sessionNote      SessionNote?
  trainerProfile   TrainerProfile?   @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  arena            Arena?            @relation(fields: [arenaId], references: [id], onDelete: SetNull)
  service          Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  availabilitySlot AvailabilitySlot? @relation("BookingToSlot", fields: [availabilitySlotId], references: [id], onDelete: SetNull)
  ownedBySlot      AvailabilitySlot? @relation("SlotOwnsBooking")
}

model SessionNote {
  id           String   @id @default(cuid())
  bookingId    String   @unique
  trainerNote  String?  @db.Text
  clientNote   String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Article {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String    @db.Text
  coverImage  String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dhKey String
  authKey   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TrainerProfile {
  id           String        @id @default(cuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName  String        @db.VarChar(191)
  bio          String?       @db.Text
  photoUrl     String?       @db.VarChar(500)
  city         String        @db.VarChar(191)
  phone        String?       @db.VarChar(50)
  status       TrainerStatus @default(PENDING)
  isFeatured   Boolean       @default(false)
  certifications Certification[]
  services     Service[]
  arenas       TrainerArena[]
  sports       TrainerSport[]
  slots        AvailabilitySlot[]
  reviews      Review[]
  bookings     Booking[]
  gallery      TrainerPhoto[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Arena {
  id          String      @id @default(cuid())
  name        String      @db.VarChar(191)
  city        String      @db.VarChar(191)
  address     String      @db.VarChar(500)
  description String?     @db.Text
  photoUrl    String?     @db.VarChar(500)
  logoUrl     String?     @db.VarChar(500)
  bannerUrl   String?     @db.VarChar(500)
  lat         Float?      @db.Double
  lng         Float?      @db.Double
  courtBookingUrl String? @db.VarChar(500)
  status      ArenaStatus @default(PENDING)
  createdById String
  createdBy   User        @relation(fields: [createdById], references: [id])
  trainers    TrainerArena[]
  sports      ArenaSport[]
  slots       AvailabilitySlot[]
  bookings    Booking[]
  photos      ArenaPhoto[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Certification {
  id        String         @id @default(cuid())
  trainerId String
  trainer   TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  name      String         @db.VarChar(191)
  issuedBy  String         @db.VarChar(191)
  year      Int
}

model ServiceTemplate {
  id          String    @id @default(cuid())
  name        String    @db.VarChar(191)
  description String?   @db.Text
  services    Service[]
  createdAt   DateTime  @default(now())
}

model Service {
  id              String           @id @default(cuid())
  trainerId       String
  trainer         TrainerProfile   @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  templateId      String?
  template        ServiceTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  name            String           @db.VarChar(191)
  description     String?          @db.Text
  durationMinutes Int
  price           Decimal?         @db.Decimal(10, 2)
  type            ServiceType      @default(INDIVIDUAL)
  maxParticipants Int?
  priceType       PriceType?
  bookings        Booking[]
  slots           AvailabilitySlot[]
}

model TrainerArena {
  trainerId String
  arenaId   String
  trainer   TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  arena     Arena          @relation(fields: [arenaId], references: [id], onDelete: Cascade)

  @@id([trainerId, arenaId])
}

model AvailabilitySlot {
  id              String         @id @default(cuid())
  trainerId       String
  trainer         TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  arenaId         String
  arena           Arena          @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  startTime       DateTime
  endTime         DateTime
  maxParticipants Int?
  status          SlotStatus     @default(AVAILABLE)
  bookingId       String?        @unique
  booking         Booking?       @relation("SlotOwnsBooking", fields: [bookingId], references: [id])
  bookings        Booking[]      @relation("BookingToSlot")
  services        Service[]
  createdAt       DateTime       @default(now())
}

model Review {
  id        String         @id @default(cuid())
  trainerId String
  trainer   TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  authorId  String
  author    User           @relation(fields: [authorId], references: [id])
  rating    Int
  comment   String?        @db.Text
  createdAt DateTime       @default(now())
}

model Sport {
  id       String  @id @default(cuid())
  name     String  @unique @db.VarChar(191)
  slug     String  @unique @db.VarChar(191)
  icon     String? @db.VarChar(10)
  iconUrl  String? @db.VarChar(500)
  trainers TrainerSport[]
  arenas   ArenaSport[]
}

model TrainerSport {
  trainerId String
  sportId   String
  trainer   TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  sport     Sport          @relation(fields: [sportId], references: [id], onDelete: Cascade)
  @@id([trainerId, sportId])
}

model ArenaSport {
  arenaId String
  sportId String
  arena   Arena @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  sport   Sport @relation(fields: [sportId], references: [id], onDelete: Cascade)
  @@id([arenaId, sportId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String   @db.VarChar(191)
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model TrainerPhoto {
  id        String         @id @default(cuid())
  trainerId String
  url       String         @db.VarChar(500)
  order     Int            @default(0)
  createdAt DateTime       @default(now())
  trainer   TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
}

model ArenaPhoto {
  id        String   @id @default(cuid())
  arenaId   String
  url       String   @db.VarChar(500)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  arena     Arena    @relation(fields: [arenaId], references: [id], onDelete: Cascade)
}

model SeoSetting {
  id          String   @id @default(cuid())
  pageSlug    String   @unique
  title       String?
  description String?  @db.Text
  ogImageUrl  String?
  keywords    String?  @db.Text
  updatedAt   DateTime @updatedAt
}

model GlobalSeoSetting {
  id                     String   @id @default("global")
  siteName               String   @default("Padėlio Treneris")
  siteUrl                String?
  defaultOgImage         String?
  twitterHandle          String?
  facebookUrl            String?
  instagramUrl           String?
  googleSiteVerification String?
  updatedAt              DateTime @updatedAt
}
